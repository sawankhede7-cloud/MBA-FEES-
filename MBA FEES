function feeBadge(val) {
  const v = val.toLowerCase();
  if (v.includes('full scholar')) return `<span class="fee fee-scholar">${val}</span>`;
  if (v.includes('scholar+diff') || v.includes('scholar + diff') || v.includes('15,000+scholar') || v.includes('5,000+scholar'))
    return `<span class="fee fee-mixed">${val}</span>`;
  const num = parseInt(val.replace(/[^0-9]/g,''));
  if (num >= 100000) return `<span class="fee fee-high">${val}</span>`;
  return `<span class="fee fee-paid">${val}</span>`;
}

function busBadge(val) {
  const v = val.toLowerCase();
  if (v === 'free') return `<span class="bus-chip bus-free">Free</span>`;
  if (v === 'not applicable') return `<span class="bus-chip bus-na">N/A</span>`;
  return `<span class="bus-chip">${val}</span>`;
}

const tbody = document.getElementById('tableBody');
