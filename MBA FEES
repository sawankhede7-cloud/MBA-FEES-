  /* ── FOOTER ── */
  .footer {
    text-align: center;
    padding: 28px 20px;
    border-top: 1px solid var(--border);
    background: var(--card);
    font-size: 13px;
    color: var(--muted);
    max-width: 1100px;
    margin: 0 auto;
  }
  .footer strong { color: var(--accent); }

  @media (max-width: 700px) {
    thead th:nth-child(3),
    tbody td:nth-child(3) { display: none; }
  }
</style>
</head>
