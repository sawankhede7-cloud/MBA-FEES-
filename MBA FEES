  .reg-fee {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 600;
    font-size: 13px;
    color: var(--text);
  }

  .bus-chip {
    display: inline-block;
    padding: 2px 9px;
    border-radius: 5px;
    font-size: 12px;
    background: var(--pill-bg);
    color: var(--muted);
    border: 1px solid var(--border);
  }
  .bus-free { background: rgba(16,185,129,0.1); color: #34d399; border-color: rgba(16,185,129,0.2); }
  .bus-na { color: #475569; background: transparent; border-color: transparent; }

  /* ── NO RESULTS ── */
  .no-results {
    text-align: center;
    padding: 40px;
    color: var(--muted);
    font-size: 14px;
    display: none;
