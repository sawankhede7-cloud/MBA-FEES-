    max-width: 1100px;
    margin: 16px auto 0;
    padding: 0 20px;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--muted);
  }
  .legend-dot {
    width: 10px; height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* ── TABLE WRAPPER ── */
  .table-wrap {
    max-width: 1100px;
    margin: 20px auto 40px;
    padding: 0 20px;
